generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum StatusLicenca {
  AGUARDANDO
  ATIVA
  SUSPENSA
  REVOGADA
  BLOQUEADA
  VENCIDA
}

enum TipoTransacao {
  RECEITA
  CREDITO
  REEMBOLSO
  AJUSTE
  PAGAMENTO_RECEBIDO
}

enum TipoBackup {
  BANCO
  IMAGENS
}

enum StatusBackup {
  EMITIDO
  CONFIRMADO
  FALHOU
}

// ── Plano ─────────────────────────────────────────────────────────────────────
model Plano {
  id                       String    @id @default(uuid())
  nome                     String    @unique
  /// Texto exibido ao cliente na tela de pagamento do Stripe, abaixo do preço.
  /// Nada de informação comercial interna aqui (margem, canal, custo) — é público.
  descricaoCheckout        String?
  limiteUsuario            Int       @default(1)
  precoMensal              Decimal   @db.Decimal(10, 2)
  precoTrimestral          Decimal?  @db.Decimal(10, 2)
  precoAnual               Decimal?  @db.Decimal(10, 2)
  valorLicencaAdicional    Decimal?  @db.Decimal(10, 2)
  descontoTrimestral       Decimal?  @db.Decimal(5, 2)
  descontoAnual            Decimal?  @db.Decimal(5, 2)
  stripePriceIdMensal      String?
  stripePriceIdTrimestral  String?
  stripePriceIdAnual       String?
  status                   String    @default("ATIVO")
  /// Exibe este plano na página pública de contratação (assine.startbig.com.br).
  /// Padrão false de propósito: plano de canal ou de uso interno não pode virar
  /// vitrine por descuido — quem entra no site só vê o que foi marcado aqui.
  publico                  Boolean   @default(false)
  criadoEm                 DateTime  @default(now())

  licencas                 Licenca[]

  @@map("planos")
}

// ── Parceiro ──────────────────────────────────────────────────────────────────
model Parceiro {
  id                 String    @id @default(uuid())
  /// Código público de indicação (ex.: "OTIK22"). É o que o parceiro divulga e o
  /// que o cliente digita — UUID não serve porque ninguém digita UUID.
  codigo             String    @unique
  nomeParceiro       String
  documento          String?
  email              String?
  contatoCelular     String?
  cidadeBase         String?
  status             String    @default("ATIVO")   // ATIVO | INATIVO

  /// Regra de comissão VIGENTE. Cada comissão gerada guarda uma cópia destes
  /// valores — mudar a regra aqui nunca reescreve o que já foi apurado.
  tipoComissao       String    @default("FIXO_MENSAL")  // FIXO_MENSAL | PERCENTUAL
  /// Usado quando tipoComissao = FIXO_MENSAL: R$ por mês coberto pelo pagamento.
  valorComissaoFixa  Decimal?  @db.Decimal(10, 2)
  /// Usado quando tipoComissao = PERCENTUAL: % sobre o valor pago.
  comissaoPercentual Decimal?  @db.Decimal(5, 2)

  observacoes        String?
  criadoEm           DateTime  @default(now())

  clientes           Cliente[]
  comissoes          ComissaoParceiro[]

  @@index([status])
  @@map("parceiros")
}

// ── ComissaoParceiro ──────────────────────────────────────────────────────────
/// Livro-razão de comissões: uma linha por pagamento que gera repasse.
///
/// O valor NÃO é recalculado na hora do repasse varrendo pagamentos — é gravado
/// quando o pagamento entra, junto com uma cópia da regra vigente naquele dia.
/// É isso que permite reajustar a comissão de um parceiro sem reescrever o
/// histórico dele, e é a diferença entre um sistema de repasse e uma planilha.
model ComissaoParceiro {
  id            String    @id @default(uuid())
  parceiroId    String
  clienteId     String
  licencaId     String?
  /// Um pagamento gera no máximo uma comissão. O índice único é a trava de
  /// idempotência: webhook reentregue não paga o parceiro duas vezes.
  pagamentoId   String    @unique

  /// Competência no formato "2026-07" — é por ela que o repasse é agrupado.
  competencia   String
  /// Valor que o cliente pagou, para conferência e para o cálculo percentual.
  valorBase     Decimal   @db.Decimal(10, 2)
  /// Meses cobertos pelo pagamento (1, 3 ou 12): comissão fixa é por mês.
  meses         Int

  /// Cópia da regra no momento da apuração — nunca ler do parceiro para exibir.
  tipoComissao  String
  parametro     Decimal   @db.Decimal(10, 2)
  /// Valor devido ao parceiro por este pagamento.
  valor         Decimal   @db.Decimal(10, 2)

  status              String    @default("PENDENTE")  // PENDENTE | PAGA | CANCELADA
  pagoEm              DateTime?
  referenciaPagamento String?
  observacao          String?
  criadoEm            DateTime  @default(now())

  parceiro   Parceiro  @relation(fields: [parceiroId],  references: [id], onDelete: Restrict)
  cliente    Cliente   @relation(fields: [clienteId],   references: [id], onDelete: Cascade)
  licenca    Licenca?  @relation(fields: [licencaId],   references: [id], onDelete: SetNull)
  pagamento  Pagamento @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)

  @@index([parceiroId, status])
  @@index([competencia])
  @@map("comissoes_parceiro")
}

// ── Usuario ───────────────────────────────────────────────────────────────────
model Usuario {
  id           String    @id @default(uuid())
  nome         String
  email        String    @unique
  senha        String
  tipoUsuario  String    @default("ADMIN")
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())

  clientes     Cliente[]
  logs         Log[]

  @@map("usuarios")
}

// ── Cliente ───────────────────────────────────────────────────────────────────
model Cliente {
  id                 String    @id @default(uuid())
  email              String
  usuarioId          String
  parceiroId         String?
  ativo              Boolean   @default(true)
  criadoEm           DateTime  @default(now())
  dataAtualizacao    DateTime  @updatedAt
  senhaHash          String?
  emailPendente      String?
  tokenEmail         String?
  tokenEmailExpiraEm DateTime?

  pf              ClientePF?
  pj              ClientePJ?
  enderecos       Endereco[]
  dispositivos    Licenca[]
  pagamentos      Pagamento[]
  transacoes      TransacaoHistorico[]
  comissoes       ComissaoParceiro[]
  backups         Backup[]

  usuario         Usuario   @relation(fields: [usuarioId],  references: [id])
  parceiroObj     Parceiro? @relation(fields: [parceiroId], references: [id])

  @@index([email])
  @@index([usuarioId])
  @@index([parceiroId])
  @@map("clientes")
}

// ── ClientePF ─────────────────────────────────────────────────────────────────
model ClientePF {
  id             String    @id @default(uuid())
  clienteId      String    @unique
  nomeCompleto   String
  cpf            String
  rg             String?
  dataNascimento DateTime?

  cliente        Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("clientes_pf")
}

// ── ClientePJ ─────────────────────────────────────────────────────────────────
model ClientePJ {
  id                 String  @id @default(uuid())
  clienteId          String  @unique
  razaoSocial        String
  cnpj               String
  nomeFantasia       String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  regimeTributario   String?
  responsavel        String?
  telefone           String?
  celular            String?
  setorAtividade     String?
  logo               String?

  cliente            Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("clientes_pj")
}

// ── Endereco ──────────────────────────────────────────────────────────────────
model Endereco {
  id          String   @id @default(uuid())
  clienteId   String
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  tipo        String   @default("PRINCIPAL")
  criadoEm    DateTime @default(now())

  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

// ── Licenca ───────────────────────────────────────────────────────────────────
model Licenca {
  id                  String        @id @default(uuid())
  clienteId           String
  planoId             String
  chaveAtivacao       String        @unique
  nomeDispositivo     String?
  status              StatusLicenca @default(AGUARDANDO)
  totalUsuarios       Int           @default(0)
  usuariosExtras      Int           @default(0)
  isTrial             Boolean       @default(false)
  diasCortesia        Int           @default(0)
  ultimoPagamento     DateTime?
  dataVencimento      DateTime?
  ultimoHeartbeat     DateTime?
  ultimaSincronizacao DateTime?
  stripeSubscriptionId String?
  planoPendenteId     String?       // plano agendado p/ valer no fim do ciclo (downgrade)
  criadoEm            DateTime      @default(now())
  dataAtivacao        DateTime?
  chaveOrigem         String        @default("MANUAL")
  atualizadoEm        DateTime      @updatedAt

  cliente             Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  plano               Plano         @relation(fields: [planoId],   references: [id])
  historico           LicencaHistorico[]
  pagamentos          Pagamento[]
  transacoes          TransacaoHistorico[]
  sessoes             LicencaSessao[]
  comissoes           ComissaoParceiro[]
  backups             Backup[]

  @@index([clienteId])
  @@index([status])
  @@map("licencas")
}

// ── LicencaHistorico ──────────────────────────────────────────────────────────
model LicencaHistorico {
  id             String    @id @default(uuid())
  licencaId      String
  tipo           String    // TRIAL | RENOVACAO | BLOQUEIO | DESBLOQUEIO
  chaveAtivacao  String
  meses          Int?
  dataVencimento DateTime?
  observacao     String?
  criadoEm       DateTime  @default(now())

  licenca        Licenca   @relation(fields: [licencaId], references: [id], onDelete: Cascade)

  @@index([licencaId])
  @@index([criadoEm])
  @@map("licencas_historico")
}

// ── Pagamento ─────────────────────────────────────────────────────────────────
model Pagamento {
  id           String   @id @default(uuid())
  licencaId    String
  clienteId    String
  valor        Decimal  @db.Decimal(10, 2)
  meses        Int      @default(1)
  status       String   @default("PAGO")
  gateway      String   @default("MANUAL")
  transacaoId  String?  @unique
  observacao   String?
  criadoEm     DateTime @default(now())

  licenca      Licenca               @relation(fields: [licencaId], references: [id])
  cliente      Cliente               @relation(fields: [clienteId], references: [id])
  transacoes   TransacaoHistorico[]
  comissao     ComissaoParceiro?

  @@index([licencaId])
  @@index([clienteId])
  @@index([criadoEm])
  @@map("pagamentos")
}

// ── TransacaoHistorico ────────────────────────────────────────────────────────
model TransacaoHistorico {
  id          String        @id @default(uuid())
  clienteId   String
  licencaId   String?
  pagamentoId String?
  tipo        TipoTransacao
  valor       Decimal       @db.Decimal(10, 2)
  origem      String        @default("MANUAL")
  descricao   String?
  criadoEm    DateTime      @default(now())

  cliente     Cliente       @relation(fields: [clienteId], references: [id])
  licenca     Licenca?      @relation(fields: [licencaId], references: [id])
  pagamento   Pagamento?    @relation(fields: [pagamentoId], references: [id])

  @@index([clienteId])
  @@index([licencaId])
  @@index([pagamentoId])
  @@index([criadoEm])
  @@map("transacoes_historico")
}

// ── Log ───────────────────────────────────────────────────────────────────────
model Log {
  id           String   @id @default(uuid())
  dataHora     DateTime @default(now())
  usuarioId    String?
  acao         String
  entidadeNome String
  entidadeId   String?
  descricao    String?
  ipAddress    String?

  usuario      Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidadeNome, entidadeId])
  @@index([dataHora])
  @@map("logs")
}

// ── LicencaSessao ─────────────────────────────────────────────────────────────
model LicencaSessao {
  id              String   @id @default(uuid())
  licencaId       String
  hwid            String
  ultimoHeartbeat DateTime @default(now())

  licenca         Licenca  @relation(fields: [licencaId], references: [id], onDelete: Cascade)

  @@unique([licencaId, hwid])
  @@index([ultimoHeartbeat])
  @@map("licencas_sessoes")
}

// ── Backup ────────────────────────────────────────────────────────────────────
/// Diário de EVENTOS de backup — não é um catálogo de arquivos restauráveis.
///
/// Na nuvem cada licença tem UM objeto por tipo, sobrescrito todo dia:
///   clientes/{clienteId}/{licencaId}/banco.zip
///   clientes/{clienteId}/{licencaId}/imagens.zip
/// Ou seja: 300 linhas aqui continuam apontando para 1 arquivo só — o de hoje.
/// Quem exibir isso na tela precisa rotular como "backups realizados" e deixar
/// separado o "cópia disponível para restaurar: 1". Listar as linhas como se
/// fossem versões baixáveis é prometer restauração que não existe.
///
/// O licencaId entra na chave de propósito: um cliente pode ter várias licenças
/// (duas lojas, dois PCs, cada uma com banco local próprio). Sem ele as duas
/// instalações escreveriam no mesmo objeto e uma apagaria o backup da outra.
model Backup {
  id               String       @id @default(uuid())
  clienteId        String
  licencaId        String
  /// Máquina que subiu. Se mudar de um dia para o outro sem troca de dispositivo
  /// registrada, é sinal de instalação paralela subindo banco velho por cima.
  hwid             String?
  tipo             TipoBackup
  chaveS3          String
  status           StatusBackup @default(EMITIDO)
  origem           String       @default("AUTOMATICO")  // AUTOMATICO | MANUAL
  /// Tamanho que o ERP declarou ao pedir a URL — é ele que vai assinado no
  /// Content-Length, então o upload só é aceito se casar exatamente.
  tamanhoBytes     Int
  /// Tamanho que o HeadObject encontrou de verdade depois do upload.
  tamanhoRealBytes Int?
  /// SHA-256 do zip. Em `imagens` é o que permite pular upload quando nada mudou
  /// — o maior corte de custo do backup, já que imagem é o que pesa.
  checksumSha256   String?
  erroMensagem     String?
  emitidoEm        DateTime     @default(now())
  confirmadoEm     DateTime?

  cliente          Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  licenca          Licenca      @relation(fields: [licencaId], references: [id], onDelete: Cascade)

  @@index([licencaId, tipo, emitidoEm])
  @@index([clienteId])
  @@index([status, emitidoEm])
  @@map("backups")
}
