generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum StatusLicenca {
  AGUARDANDO
  ATIVA
  SUSPENSA
  REVOGADA
  BLOQUEADA
  VENCIDA
}

enum TipoTransacao {
  RECEITA
  CREDITO
  REEMBOLSO
  AJUSTE
  PAGAMENTO_RECEBIDO
}

/// Os dois papéis dentro de um CICLO (uma semana, aberta na segunda-feira).
///
/// FULL é o acervo inteiro num pacote — banco completo mais todos os arquivos.
/// Sobe no primeiro login do ciclo, e é ele que autoriza apagar o ciclo anterior:
/// só se pode destruir a cópia velha porque a nova contém tudo que ela continha.
///
/// FRAGMENTO é o que mudou desde o envio anterior — tabelas alteradas e arquivos
/// novos, montados pelo ERP a partir de uma pasta de pendentes alimentada no
/// momento da escrita. A granularidade é por tabela e por arquivo, nunca por
/// registro: isso dá a mesma semântica dos arquivos ("a última versão vence"), e
/// é o que torna a restauração uma extração em ordem em vez de um replay de
/// registros dentro do banco.
///
/// A integridade referencial se sustenta por construção: se uma venda nova aponta
/// para um cliente novo, as duas tabelas mudaram no mesmo dia e as duas estão no
/// mesmo fragmento. Não existe linha órfã.
enum TipoBackup {
  FULL
  FRAGMENTO
}

enum StatusBackup {
  EMITIDO
  CONFIRMADO
  FALHOU
  /// Apagado da nuvem pela rotação de ciclo. A linha fica: sem ela a restauração
  /// tentaria assinar URL para objeto inexistente, e o histórico perderia o
  /// registro de que aquele ciclo existiu.
  REMOVIDO
}

// ── Plano ─────────────────────────────────────────────────────────────────────
model Plano {
  id                       String    @id @default(uuid())
  nome                     String    @unique
  /// Texto exibido ao cliente na tela de pagamento do Stripe, abaixo do preço.
  /// Nada de informação comercial interna aqui (margem, canal, custo) — é público.
  descricaoCheckout        String?
  limiteUsuario            Int       @default(1)
  precoMensal              Decimal   @db.Decimal(10, 2)
  precoTrimestral          Decimal?  @db.Decimal(10, 2)
  precoAnual               Decimal?  @db.Decimal(10, 2)
  valorLicencaAdicional    Decimal?  @db.Decimal(10, 2)
  descontoTrimestral       Decimal?  @db.Decimal(5, 2)
  descontoAnual            Decimal?  @db.Decimal(5, 2)
  stripePriceIdMensal      String?
  stripePriceIdTrimestral  String?
  stripePriceIdAnual       String?
  status                   String    @default("ATIVO")
  /// Exibe este plano na página pública de contratação (assine.startbig.com.br).
  /// Padrão false de propósito: plano de canal ou de uso interno não pode virar
  /// vitrine por descuido — quem entra no site só vê o que foi marcado aqui.
  publico                  Boolean   @default(false)
  criadoEm                 DateTime  @default(now())

  licencas                 Licenca[]
  cobrancas                CobrancaRenovacao[]

  @@map("planos")
}

// ── Parceiro ──────────────────────────────────────────────────────────────────
model Parceiro {
  id                 String    @id @default(uuid())
  /// Código público de indicação (ex.: "OTIK22"). É o que o parceiro divulga e o
  /// que o cliente digita — UUID não serve porque ninguém digita UUID.
  codigo             String    @unique
  nomeParceiro       String
  documento          String?
  email              String?
  contatoCelular     String?
  cidadeBase         String?
  status             String    @default("ATIVO")   // ATIVO | INATIVO

  /// Regra de comissão VIGENTE. Cada comissão gerada guarda uma cópia destes
  /// valores — mudar a regra aqui nunca reescreve o que já foi apurado.
  tipoComissao       String    @default("FIXO_MENSAL")  // FIXO_MENSAL | PERCENTUAL
  /// Usado quando tipoComissao = FIXO_MENSAL: R$ por mês coberto pelo pagamento.
  valorComissaoFixa  Decimal?  @db.Decimal(10, 2)
  /// Usado quando tipoComissao = PERCENTUAL: % sobre o valor pago.
  comissaoPercentual Decimal?  @db.Decimal(5, 2)

  observacoes        String?
  criadoEm           DateTime  @default(now())

  clientes           Cliente[]
  comissoes          ComissaoParceiro[]

  @@index([status])
  @@map("parceiros")
}

// ── ComissaoParceiro ──────────────────────────────────────────────────────────
/// Livro-razão de comissões: uma linha por pagamento que gera repasse.
///
/// O valor NÃO é recalculado na hora do repasse varrendo pagamentos — é gravado
/// quando o pagamento entra, junto com uma cópia da regra vigente naquele dia.
/// É isso que permite reajustar a comissão de um parceiro sem reescrever o
/// histórico dele, e é a diferença entre um sistema de repasse e uma planilha.
model ComissaoParceiro {
  id            String    @id @default(uuid())
  parceiroId    String
  clienteId     String
  licencaId     String?
  /// Um pagamento gera no máximo uma comissão. O índice único é a trava de
  /// idempotência: webhook reentregue não paga o parceiro duas vezes.
  pagamentoId   String    @unique

  /// Competência no formato "2026-07" — é por ela que o repasse é agrupado.
  competencia   String
  /// Valor que o cliente pagou, para conferência e para o cálculo percentual.
  valorBase     Decimal   @db.Decimal(10, 2)
  /// Meses cobertos pelo pagamento (1, 3 ou 12): comissão fixa é por mês.
  meses         Int

  /// Cópia da regra no momento da apuração — nunca ler do parceiro para exibir.
  tipoComissao  String
  parametro     Decimal   @db.Decimal(10, 2)
  /// Valor devido ao parceiro por este pagamento.
  valor         Decimal   @db.Decimal(10, 2)

  status              String    @default("PENDENTE")  // PENDENTE | PAGA | CANCELADA
  pagoEm              DateTime?
  referenciaPagamento String?
  observacao          String?
  criadoEm            DateTime  @default(now())

  parceiro   Parceiro  @relation(fields: [parceiroId],  references: [id], onDelete: Restrict)
  cliente    Cliente   @relation(fields: [clienteId],   references: [id], onDelete: Cascade)
  licenca    Licenca?  @relation(fields: [licencaId],   references: [id], onDelete: SetNull)
  pagamento  Pagamento @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)

  @@index([parceiroId, status])
  @@index([competencia])
  @@map("comissoes_parceiro")
}

// ── Usuario ───────────────────────────────────────────────────────────────────
model Usuario {
  id           String    @id @default(uuid())
  nome         String
  email        String    @unique
  senha        String
  tipoUsuario  String    @default("ADMIN")
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())

  clientes     Cliente[]
  logs         Log[]
  inscricoesPush InscricaoPush[]

  @@map("usuarios")
}

// ── Cliente ───────────────────────────────────────────────────────────────────
model Cliente {
  id                 String    @id @default(uuid())
  email              String
  usuarioId          String
  parceiroId         String?
  ativo              Boolean   @default(true)
  criadoEm           DateTime  @default(now())
  dataAtualizacao    DateTime  @updatedAt
  senhaHash          String?
  emailPendente      String?
  tokenEmail         String?
  tokenEmailExpiraEm DateTime?
  /// Id deste cliente dentro do Asaas, criado na primeira cobranca PIX e
  /// reaproveitado nas seguintes. Sem guardar, cada PIX criaria um cadastro novo
  /// la e o historico do cliente ficaria espalhado em N clientes soltos.
  asaasCustomerId    String?   @unique

  pf              ClientePF?
  pj              ClientePJ?
  enderecos       Endereco[]
  dispositivos    Licenca[]
  pagamentos      Pagamento[]
  transacoes      TransacaoHistorico[]
  comissoes       ComissaoParceiro[]
  backups         Backup[]
  cobrancas       CobrancaRenovacao[]

  usuario         Usuario   @relation(fields: [usuarioId],  references: [id])
  parceiroObj     Parceiro? @relation(fields: [parceiroId], references: [id])

  @@index([email])
  @@index([usuarioId])
  @@index([parceiroId])
  @@map("clientes")
}

// ── ClientePF ─────────────────────────────────────────────────────────────────
model ClientePF {
  id             String    @id @default(uuid())
  clienteId      String    @unique
  nomeCompleto   String
  cpf            String
  rg             String?
  dataNascimento DateTime?

  cliente        Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("clientes_pf")
}

// ── ClientePJ ─────────────────────────────────────────────────────────────────
model ClientePJ {
  id                 String  @id @default(uuid())
  clienteId          String  @unique
  razaoSocial        String
  cnpj               String
  nomeFantasia       String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  regimeTributario   String?
  responsavel        String?
  telefone           String?
  celular            String?
  setorAtividade     String?
  logo               String?

  cliente            Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("clientes_pj")
}

// ── Endereco ──────────────────────────────────────────────────────────────────
model Endereco {
  id          String   @id @default(uuid())
  clienteId   String
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  tipo        String   @default("PRINCIPAL")
  criadoEm    DateTime @default(now())

  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

// ── Licenca ───────────────────────────────────────────────────────────────────
model Licenca {
  id                  String        @id @default(uuid())
  clienteId           String
  planoId             String
  chaveAtivacao       String        @unique
  nomeDispositivo     String?
  status              StatusLicenca @default(AGUARDANDO)
  totalUsuarios       Int           @default(0)
  usuariosExtras      Int           @default(0)
  isTrial             Boolean       @default(false)
  diasCortesia        Int           @default(0)
  ultimoPagamento     DateTime?
  dataVencimento      DateTime?
  ultimoHeartbeat     DateTime?
  ultimaSincronizacao DateTime?
  stripeSubscriptionId String?
  /// Ate quando a licenca continua valendo mesmo vencida. Preenchido SO quando o
  /// cartao falha (invoice.payment_failed), enquanto o Stripe re-tenta a cobranca.
  /// Quem paga por PIX nunca tem isto preenchido e trava no vencimento — a
  /// carencia e da falha do meio de pagamento, nao um favor ao cliente.
  carenciaAte         DateTime?
  planoPendenteId     String?       // plano agendado p/ valer no fim do ciclo (downgrade)
  criadoEm            DateTime      @default(now())
  dataAtivacao        DateTime?
  chaveOrigem         String        @default("MANUAL")
  atualizadoEm        DateTime      @updatedAt

  cliente             Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  plano               Plano         @relation(fields: [planoId],   references: [id])
  historico           LicencaHistorico[]
  pagamentos          Pagamento[]
  transacoes          TransacaoHistorico[]
  sessoes             LicencaSessao[]
  comissoes           ComissaoParceiro[]
  backups             Backup[]
  cobrancas           CobrancaRenovacao[]

  @@index([clienteId])
  @@index([status])
  @@map("licencas")
}

// ── LicencaHistorico ──────────────────────────────────────────────────────────
model LicencaHistorico {
  id             String    @id @default(uuid())
  licencaId      String
  tipo           String    // TRIAL | RENOVACAO | BLOQUEIO | DESBLOQUEIO
  chaveAtivacao  String
  meses          Int?
  dataVencimento DateTime?
  observacao     String?
  criadoEm       DateTime  @default(now())

  licenca        Licenca   @relation(fields: [licencaId], references: [id], onDelete: Cascade)

  @@index([licencaId])
  @@index([criadoEm])
  @@map("licencas_historico")
}

// ── Pagamento ─────────────────────────────────────────────────────────────────
model Pagamento {
  id           String   @id @default(uuid())
  licencaId    String
  clienteId    String
  valor        Decimal  @db.Decimal(10, 2)
  meses        Int      @default(1)
  status       String   @default("PAGO")
  gateway      String   @default("MANUAL")
  transacaoId  String?  @unique
  observacao   String?
  criadoEm     DateTime @default(now())

  licenca      Licenca               @relation(fields: [licencaId], references: [id])
  cliente      Cliente               @relation(fields: [clienteId], references: [id])
  transacoes   TransacaoHistorico[]
  comissao     ComissaoParceiro?
  cobranca     CobrancaRenovacao?

  @@index([licencaId])
  @@index([clienteId])
  @@index([criadoEm])
  @@map("pagamentos")
}

// ── TransacaoHistorico ────────────────────────────────────────────────────────
model TransacaoHistorico {
  id          String        @id @default(uuid())
  clienteId   String
  licencaId   String?
  pagamentoId String?
  tipo        TipoTransacao
  valor       Decimal       @db.Decimal(10, 2)
  origem      String        @default("MANUAL")
  descricao   String?
  criadoEm    DateTime      @default(now())

  cliente     Cliente       @relation(fields: [clienteId], references: [id])
  licenca     Licenca?      @relation(fields: [licencaId], references: [id])
  pagamento   Pagamento?    @relation(fields: [pagamentoId], references: [id])

  @@index([clienteId])
  @@index([licencaId])
  @@index([pagamentoId])
  @@index([criadoEm])
  @@map("transacoes_historico")
}

// ── Log ───────────────────────────────────────────────────────────────────────
model Log {
  id           String   @id @default(uuid())
  dataHora     DateTime @default(now())
  usuarioId    String?
  acao         String
  entidadeNome String
  entidadeId   String?
  descricao    String?
  ipAddress    String?

  usuario      Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidadeNome, entidadeId])
  @@index([dataHora])
  @@map("logs")
}

// ── LicencaSessao ─────────────────────────────────────────────────────────────
model LicencaSessao {
  id              String   @id @default(uuid())
  licencaId       String
  hwid            String
  ultimoHeartbeat DateTime @default(now())

  licenca         Licenca  @relation(fields: [licencaId], references: [id], onDelete: Cascade)

  @@unique([licencaId, hwid])
  @@index([ultimoHeartbeat])
  @@map("licencas_sessoes")
}

// ── Backup ────────────────────────────────────────────────────────────────────
/// Diário de EVENTOS de backup — não é um catálogo de arquivos restauráveis.
///
/// Na nuvem cada licença tem um objeto por tipo ESPELHO, sobrescrito todo dia,
/// mais um objeto por mês de OS, que sobe uma vez e nunca mais:
///   clientes/{clienteId}/{licencaId}/banco.zip
///   clientes/{clienteId}/{licencaId}/imagens.zip
///   clientes/{clienteId}/{licencaId}/os-2026-07.zip
/// Ou seja: 300 linhas aqui NÃO são 300 arquivos. Para banco e imagens existe uma
/// cópia só — a de hoje. Quem exibir isso na tela precisa rotular como "backups
/// realizados" e deixar separado o que está disponível para restaurar. Listar as
/// linhas como se fossem versões baixáveis é prometer restauração que não existe.
///
/// O licencaId entra na chave de propósito: um cliente pode ter várias licenças
/// (duas lojas, dois PCs, cada uma com banco local próprio). Sem ele as duas
/// instalações escreveriam no mesmo objeto e uma apagaria o backup da outra.
model Backup {
  id               String       @id @default(uuid())
  clienteId        String
  licencaId        String
  /// Máquina que subiu. Se mudar de um dia para o outro sem troca de dispositivo
  /// registrada, é sinal de instalação paralela subindo banco velho por cima.
  hwid             String?
  tipo             TipoBackup
  /// Ciclo a que este envio pertence, em 'YYYY-MM-DD' — sempre a SEGUNDA-FEIRA
  /// que o abriu.
  ///
  /// Texto e não data porque a única operação que se faz com ele é comparar e
  /// ordenar, e 'YYYY-MM-DD' ordena igual em texto e em data, sem fuso no meio.
  ///
  /// A âncora é a segunda-feira, e não um contador de "dia 1 a 7", porque
  /// contador é ESTADO: some numa reinstalação, diverge entre as duas pontas, e
  /// aí ninguém mais sabe em que dia do ciclo está. A segunda de referência os
  /// dois lados derivam da data e sempre chegam no mesmo valor — e é o próprio
  /// nome da pasta no bucket.
  ciclo            String
  /// Ordem de extração dentro do ciclo. 0 é sempre o FULL; os fragmentos seguem
  /// 1, 2, 3...
  ///
  /// Explícito, e não derivado de `emitidoEm`, porque restaurar na ordem errada
  /// produz um banco silenciosamente errado — a última versão de cada tabela
  /// venceria pela hora do relógio, e dois envios no mesmo segundo (ou com
  /// relógio ajustado no meio) resolveriam o empate de forma indefinida.
  sequencia        Int          @default(0)
  chaveS3          String
  status           StatusBackup @default(EMITIDO)
  origem           String       @default("AUTOMATICO")  // AUTOMATICO | MANUAL
  /// Tamanho que o ERP declarou ao pedir a URL — é ele que vai assinado no
  /// Content-Length, então o upload só é aceito se casar exatamente.
  tamanhoBytes     Int
  /// Tamanho que o HeadObject encontrou de verdade depois do upload.
  tamanhoRealBytes Int?
  /// O código que o ERP calcula sobre a pasta de pendentes. É o que permite
  /// responder "não precisa subir, nada mudou" sem abrir o pacote.
  ///
  /// O servidor NÃO recalcula nem confere este valor — guarda a string e compara
  /// por igualdade literal com a do último envio CONFIRMADO. O contrato do campo
  /// é só um: muda quando o conteúdo muda, não muda quando não muda.
  ///
  /// ⚠ A comparação é contra o último CONFIRMADO, nunca contra a linha emitida.
  /// Promover o código na autorização faria o seguinte: o upload morre no meio,
  /// no login seguinte o ERP manda o mesmo código, bate, respondemos "nada novo"
  /// — e aquele conteúdo nunca sobe, sem erro em lugar nenhum.
  codigoConteudo   String?
  erroMensagem     String?
  emitidoEm        DateTime     @default(now())
  confirmadoEm     DateTime?

  cliente          Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  licenca          Licenca      @relation(fields: [licencaId], references: [id], onDelete: Cascade)

  @@index([licencaId, tipo, emitidoEm])
  /// Sustenta as duas perguntas mais frequentes do fluxo: "este ciclo já tem full
  /// confirmado?" e "qual a corrente deste ciclo, em ordem?".
  @@index([licencaId, ciclo, status, sequencia])
  @@index([clienteId])
  @@index([status, emitidoEm])
  @@map("backups")
}

// ── CobrancaRenovacao ─────────────────────────────────────────────────────────
/// Cobrança de renovação criada por nós ANTES de o cliente pagar.
///
/// Existe para que o webhook do gateway nunca precise acreditar no payload. O
/// `externalReference` mandado ao Asaas é o id desta linha; quando o pagamento
/// cai, meses e valor são lidos DAQUI — do nosso banco — e não do corpo da
/// requisição. Sem isso, quem forjasse um webhook escolheria também quantos
/// meses ganhar, e a assinatura do webhook viraria a única defesa.
///
/// Serve ainda como trava de idempotência: dois cliques no botão de pagar
/// reaproveitam a mesma linha PENDENTE em vez de abrir dois PIX para a mesma
/// licença — e como registro de PIX gerado e não pago, que é dado de venda.
model CobrancaRenovacao {
  id                String    @id @default(uuid())
  licencaId         String
  clienteId         String
  /// Plano vigente no momento da cobrança, guardado explicitamente: a licença
  /// pode trocar de plano depois, e o valor cobrado precisa continuar
  /// explicável meses mais tarde, sem depender do estado atual.
  planoId           String
  meses             Int
  /// Em reais, como todo o resto do sistema (Decimal 10,2). A conversão para os
  /// centavos que o ERP espera acontece só na borda do endpoint.
  valor             Decimal   @db.Decimal(10, 2)
  gateway           String                          // ASAAS | STRIPE
  metodo            String                          // PIX | CARTAO
  status            String    @default("PENDENTE")  // PENDENTE | PAGA | EXPIRADA | CANCELADA
  /// Id da cobrança no gateway (`pay_...` no Asaas). Único de propósito: é a
  /// chave de idempotência do webhook — a mesma entrega, reprocessada, não pode
  /// renovar duas vezes.
  gatewayCobrancaId String?   @unique
  copiaECola        String?
  qrCodeBase64      String?
  urlCheckout       String?
  expiraEm          DateTime?
  pagoEm            DateTime?
  /// Preenchido quando a cobrança vira dinheiro no financeiro. Une a intenção
  /// de pagar ao pagamento de fato — sem isso não dá para auditar quanto do que
  /// foi gerado realmente converteu.
  pagamentoId       String?   @unique
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  licenca           Licenca    @relation(fields: [licencaId],   references: [id], onDelete: Cascade)
  cliente           Cliente    @relation(fields: [clienteId],   references: [id], onDelete: Cascade)
  plano             Plano      @relation(fields: [planoId],     references: [id])
  pagamento         Pagamento? @relation(fields: [pagamentoId], references: [id])

  @@index([licencaId, status])
  @@index([status, expiraEm])
  @@map("cobrancas_renovacao")
}

// ── InscricaoPush ─────────────────────────────────────────────────────────────
/// Um aparelho autorizado a receber notificação push do painel.
///
/// Uma linha por DISPOSITIVO, não por pessoa: o mesmo admin pode ter o celular
/// e o desktop inscritos, e cada um tem seu próprio endpoint no serviço de push
/// do fabricante (Apple, Google). Desinscrever o celular não pode calar o resto.
///
/// Guardar no banco, e não em memória, é o que faz a inscrição sobreviver a um
/// `pm2 restart` — sem isso, todo deploy silenciaria as notificações até alguém
/// reabrir o painel em cada aparelho, e ninguém perceberia que parou.
model InscricaoPush {
  id             String    @id @default(uuid())
  /// URL que o navegador nos deu para entregar a mensagem. Única: é a
  /// identidade do aparelho, e reinscrever o mesmo device tem que atualizar
  /// a linha existente em vez de criar uma segunda que duplicaria o aviso.
  endpoint       String    @unique
  /// Chaves de criptografia do aparelho. A mensagem viaja cifrada de ponta a
  /// ponta — nem a Apple nem o Google conseguem ler o valor do pagamento.
  p256dh         String
  auth           String
  usuarioId      String?
  /// Rótulo legível para a tela de gerenciamento ("iPhone", "Chrome no
  /// Windows"). Sem isto, revogar um aparelho perdido vira adivinhação.
  descricao      String?
  criadoEm       DateTime  @default(now())
  ultimoEnvioEm  DateTime?
  /// Entregas seguidas recusadas. O serviço de push responde 404/410 quando o
  /// aparelho desinstalou o app ou revogou a permissão; nesse caso a linha é
  /// apagada na hora. Este contador cobre a falha intermitente, que não deve
  /// apagar nada mas também não pode ficar sendo tentada para sempre.
  falhasSeguidas Int       @default(0)

  usuario        Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("inscricoes_push")
}
