# ============================================================================
# Exemplo de variáveis de ambiente do servidor (apps/server)
# Copie para apps/server/.env e preencha. NUNCA versione o .env real.
# ============================================================================

# --- Ambiente ---------------------------------------------------------------
# Em produção DEVE ser "production" — ativa as travas de segurança
# (JWT_SECRET obrigatório, CORS restrito). O PM2 (ecosystem.config.js) já força isso.
NODE_ENV=production

# Porta HTTP da API (padrão 3001 se ausente)
PORT=3001

# --- Segurança --------------------------------------------------------------
# OBRIGATÓRIO em produção. Segredo forte e aleatório para assinar o JWT do admin.
# Gere um: openssl rand -base64 48
JWT_SECRET=

# Origens permitidas a chamar a API pelo navegador (separadas por vírgula).
# Ex.: https://admin.startbig.com.br
# Se vazio em produção, nenhum acesso cross-origin de browser é permitido.
CORS_ORIGINS=

# --- Banco de dados ---------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# --- Stripe -----------------------------------------------------------------
# O modo (test/live) é derivado do prefixo da STRIPE_SECRET_KEY (sk_test / sk_live).
# O webhook recusa evento cujo livemode não bate com esse modo — então as duas
# variáveis abaixo têm que ser sempre do MESMO ambiente.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Plano do auto-cadastro -------------------------------------------------
# UUID do plano em que a licença trial do auto-cadastro do ERP é criada. Como o
# cliente não troca de plano sozinho, é este plano que define o Price cobrado
# quando ele assinar. Se vazio, usa o plano ATIVO mais barato.
PLANO_AUTOCADASTRO_ID=

# --- Alertas operacionais ---------------------------------------------------
# Para onde vai o aviso quando um pagamento chega e é descartado sem licença
# correspondente. Sem isso o descarte só aparece no log do servidor.
ADMIN_ALERT_EMAIL=

# URL pública do app (usada nos redirects de checkout do Stripe)
APP_URL=

# --- Chaves RSA da licença (base64) ----------------------------------------
LICENCA_PRIVATE_KEY=
LICENCA_PUBLIC_KEY=

# --- Backup em nuvem (Cloudflare R2) ---------------------------------------
# Bucket privado onde ficam os backups do ERP local. Cada licença tem UM
# banco.zip e UM imagens.zip, sobrescritos a cada backup.
#
# Estas credenciais ficam SÓ aqui, na API. O ERP nunca as recebe — ele só recebe
# URL assinada com validade de minutos. Chave embutida no ERP seria extraível, e
# uma licença vazada daria acesso ao backup de todos os clientes.
#
# Onde achar no painel da Cloudflare: R2 > Manage API Tokens > Create Token,
# permissão "Object Read & Write" restrita a este bucket.
# O ENDPOINT é https://<ACCOUNT_ID>.r2.cloudflarestorage.com (sem o nome do bucket).
#
# Ausentes = backup desligado: as rotas /erp/backup/* respondem
# BACKUP_NAO_CONFIGURADO e o resto da API sobe normal.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# 'auto' é o valor que o R2 espera; só mude se trocar para a AWS.
BACKUP_S3_REGION=auto

# --- E-mail (Resend e/ou SMTP) ---------------------------------------------
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
